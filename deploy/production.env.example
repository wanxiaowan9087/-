# Copy to deploy/production.env on the Alibaba Cloud server and replace every value.
# Keep this file private. Do not commit deploy/production.env or certificate files.
COMPOSE_PROJECT_NAME=agent_robot

POSTGRES_DB=agent_robot
POSTGRES_USER=agent_robot
POSTGRES_PASSWORD=replace-with-a-random-database-password

DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
APP_ADMIN_USERNAME=xiaow
APP_ADMIN_PASSWORD=replace-with-a-6-to-20-character-password-using-letter-number-symbol
APP_ADMIN_NICKNAME=Administrator
APP_CURSOR_SIGNING_SECRET=replace-with-a-random-secret-of-at-least-32-characters
APP_PHONE_ENCRYPTION_KEY=replace-with-a-base64-encoded-16-24-or-32-byte-key
APP_PHONE_LOOKUP_HMAC_KEY=replace-with-a-random-key-of-at-least-32-characters
APP_SMS_VERIFY_MAX_ATTEMPTS=5
APP_SMS_VERIFY_ATTEMPT_WINDOW_SECONDS=900
APP_SMS_VERIFY_LOCK_SECONDS=900
APP_CORS_ORIGINS=["https://robot.example.com"]
APP_LOG_LEVEL=INFO

# Used for DNS, TLS certificate instructions, and deployment documentation.
APP_DOMAIN=robot.example.com
