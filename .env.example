APP_ENVIRONMENT=development
APP_DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent
APP_REDIS_URL=redis://localhost:6379/0
APP_CORS_ORIGINS=http://localhost:5173
APP_DEMO_AUTH_ENABLED=true
APP_ADMIN_USERNAME=xiaow
# Use a 6-20 character password containing a letter, number, and special character.
APP_ADMIN_PASSWORD=replace-with-a-local-secret
# Both ordinary users and the administrator authenticate with this phone number.
# Override the legacy default in production with APP_ADMIN_PHONE.
APP_ADMIN_PHONE=replace-with-the-admin-mobile-number
APP_ADMIN_NICKNAME=系统管理员
APP_CURSOR_SIGNING_SECRET=replace-in-production
# Optional live Agent runtime. Keep false for contract/UI work; set true only
# after installing the ai extra and configuring DASHSCOPE_API_KEY.
APP_AGENT_RUNTIME_ENABLED=false
APP_AGENT_MODEL_NAME=qwen3-max
APP_AGENT_EMBEDDING_MODEL_NAME=text-embedding-v4
APP_AGENT_VECTOR_STORE_PATH=data/chroma
# Optional dedicated按量付费 Key for qwen3.7-text-rerank. If omitted, the
# reranker falls back to DASHSCOPE_API_KEY for backwards compatibility.
DASHSCOPE_RERANK_API_KEY=

